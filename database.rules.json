{
  "rules": {
    ".read": false,
    ".write": false,
    "pets": {
      ".read": true,
      "$petId": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'kawangoleiro79@gmail.com'"
      }
    },
    "products": {
      ".read": true,
      "$productId": {
        ".write": "auth != null && auth.token.email == 'kawangoleiro79@gmail.com'"
      }
    },
    "gallery": {
      ".read": true,
      "$galleryId": {
        ".write": "auth != null && auth.token.email == 'kawangoleiro79@gmail.com'"
      }
    },
    "services": {
      ".read": true,
      "$serviceId": {
        ".write": "auth != null && auth.token.email == 'kawangoleiro79@gmail.com'"
      }
    },
    "professionals": {
      ".read": true,
      "$professionalId": {
        ".write": "auth != null && auth.token.email == 'kawangoleiro79@gmail.com'"
      }
    },
    "users": {
      ".read": "auth != null && auth.token.email == 'kawangoleiro79@gmail.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'kawangoleiro79@gmail.com')",
        ".write": "auth != null && (auth.token.email == 'kawangoleiro79@gmail.com' || (auth.uid == $uid && (!data.exists() ? newData.child('role').val() == 'cliente' : (newData.child('role').val() == data.child('role').val() || (data.child('role').val() == null && newData.child('role').val() == 'cliente')))))",
        "adoptionRequests": {
          "$requestId": {
            ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'kawangoleiro79@gmail.com')",
            ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'kawangoleiro79@gmail.com')"
          }
        }
      }
    },
    "usuarios": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        "favoritos": {
          ".read": "auth != null && auth.uid == $userId",
          ".write": "auth != null && auth.uid == $userId"
        },
        "historico": {
          ".read": "auth != null && auth.uid == $userId",
          ".write": "auth != null && (auth.uid == $userId || auth.token.email == 'kawangoleiro79@gmail.com')"
        }
      }
    },
    "solicitacoes": {
      ".read": "auth != null && auth.token.email == 'kawangoleiro79@gmail.com'",
      "$requestId": {
        ".read": "auth != null && (data.child('userId').val() == auth.uid || data.child('uid').val() == auth.uid || auth.token.email == 'kawangoleiro79@gmail.com')",
        ".write": "auth != null && (auth.token.email == 'kawangoleiro79@gmail.com' || ((!data.exists() && (newData.child('userId').val() == auth.uid || newData.child('uid').val() == auth.uid)) || (data.child('userId').val() == auth.uid || data.child('uid').val() == auth.uid)))",
        ".validate": "newData.hasChildren(['petId', 'userId']) || newData.hasChildren(['petId', 'uid'])"
      }
    },
    "appointments": {
      "$appointmentId": {
        ".read": "auth != null && auth.token.email == 'kawangoleiro79@gmail.com'",
        ".write": "auth != null && auth.token.email == 'kawangoleiro79@gmail.com'"
      }
    },
    "bookings": {
      "$bookingId": {
        ".read": "auth != null && (auth.token.email == 'kawangoleiro79@gmail.com' || data.child('customerId').val() == auth.uid)",
        ".write": "auth != null && (auth.token.email == 'kawangoleiro79@gmail.com' || (!data.exists() && newData.child('customerId').val() == auth.uid))"
      }
    }
  }
}
